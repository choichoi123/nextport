# .env.local에 복사한 뒤 실제 값을 입력합니다. 실제 토큰을 이 파일에 저장하지 마세요.
# Notion 값을 모두 비워 두면 요청 없이 빈 프로젝트 목록 안내를 표시합니다.

# Notion 내부 연결의 API 토큰 (Read content 권한과 원본 DB 연결 필요)
NOTION_TOKEN=""

# 기존 원본 데이터베이스 ID: 단일 데이터 소스는 자동으로 선택합니다.
NOTION_DATABASE_ID=""

# 선택: 데이터베이스에 소스가 여러 개면 대상 데이터 소스 ID를 지정합니다.
# 이 값을 직접 지정하면 NOTION_DATABASE_ID는 비워도 됩니다. 토큰은 필요합니다.
NOTION_DATA_SOURCE_ID=""

# 선택: 놀이터의 온라인 TOP10. 미설정이면 로컬 경기·미리보기만 제공합니다.
# 운영 Notion 값과 별도로 관리하며, 개발 DB 설정만 로컬에 사용합니다.
# 연결 문자열은 전용 sprint_runtime 역할을 사용합니다. 실제 값은 Git에 넣지 마세요.
PLAYGROUND_LEADERBOARD_ENABLED="false"
PLAYGROUND_DATABASE_URL=""
# 32바이트 이상인 별도 서버 비밀. NEXT_PUBLIC_ 접두사를 사용하지 않습니다.
PLAYGROUND_SIGNING_SECRET=""

# 등록 IP 만료 정리용 Vercel Cron 인증. 기본 로컬 값은 비워 둡니다.
# 32바이트 이상인 별도 서버 전용 비밀. NEXT_PUBLIC_에 노출하지 않습니다.
CRON_SECRET=""
